# PostgreSQL — em dev, o do docker-compose.yml na raiz (docker compose up -d).
# Em produção, o self-hosted (VM Vultr).
DATABASE_URL="postgresql://zello:zello@localhost:5434/zello?schema=public"

# Auth — gere um valor forte: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Frontend permitido pelo CORS (dashboard em dev)
CORS_ORIGIN=http://localhost:5173

PORT=3000
